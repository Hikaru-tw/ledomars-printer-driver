
[Version]
Signature="$CHICAGO$"
;ver=00.00.00
Class=Printer
Provider=%LEDOMARS%
LayoutFile=layout.inf
DriverVer=01/07/2019, 1.4.0.1

[Manufacturer]
%LEDOMARS%=LP8000E


[LP8000E]
 "LEDOMARS LP-8000E"=LP8000E.DRV,LPTENUM\LEDOMARS_LP-8000EC075,LEDOMARS_LP-8000E
 "LEDOMARS LP-8000E"=LP8000E.DRV,USBPRINT\LEDOMARS_LP-8000EC075,LEDOMARS_LP-8000E

[LP8000E.DRV]
 CopyFiles=@LP8000E.DRV,UNI,MON
 DataSection=UNI_DATA
 DriverFile=LP8000E.DRV
 DataFile=LP8000E.DRV
 PortMonitor=LMUSB,LMUsbMon.dll
 

[UNI]
 UNIDRV.DLL,,,0x00000020         ; Copy only if new binary
 UNIDRV.HLP,,,0x00000020         ; Copy only if new binary
 ICONLIB.DLL,,,0x00000020         ; Copy only if new binary
 DMCOLOR.DLL,,,0x00000020         ; Copy only if new binary

[UNI_DATA]
 HelpFile=UNIDRV.HLP
 DefaultDataType=EMF

[MON]
LMUsbMon.dll

[DestinationDirs]
 DefaultDestDir=11

[SourceDisksNames]
1="LP-8000E Driver Source Disk",,0

[SourceDisksFiles]
 LP8000E.DRV=1
 LMUsbMon.dll=1

[Strings]
 LEDOMARS="LEDOMARS"

 