;	List of supported printers, manufacturers
; (PNPID:LEDOMARS)

[Version]
Signature="$Windows NT$"
Provider=%ProviderName%
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Class=Printer
CatalogFile=BP2000.cat
DriverVer=07/24/2018, 1.0.0.1

; ------------------------------
[Manufacturer]
%Providername%= LEDOMARS, NTx86.6.0, NTamd64.5.1, NTIA64.5.1

; ------------------------------
[LEDOMARS]
"LEDOMARS BP-2000" = BP2000.files,LPTENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files,SERENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files,USBPRINT\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000

[LEDOMARS.NTx86.6.0]
"LEDOMARS BP-2000" = BP2000.files,LPTENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files,SERENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files,USBPRINT\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000

[LEDOMARS.NTamd64.5.1]
"LEDOMARS BP-2000" = BP2000.files64,LPTENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files,SERENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files64,USBPRINT\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000

[LEDOMARS.NTIA64.5.1]
"LEDOMARS BP-2000" = BP2000.files64,LPTENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files,SERENUM\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000
"LEDOMARS BP-2000" = BP2000.files64,USBPRINT\LEDOMARS_BP-20006D2B,LEDOMARS_BP-2000

; ++++++++++++++++++++++++++++++
[BP2000.files]
CopyFiles = @BP2000.Dll,@BP2000.GPD,OEM_SETUP
DataSection = OEM_BIDI_DATA
DataFile = BP2000.GPD
Include = NTPRINT.INF
Needs = UNIDRV.OEM
AddReg=UninstInfo.AddReg

[BP2000.files64]
CopyFiles = @BP2000.Dll,@BP2000.GPD,OEM_SETUP
DataSection = OEM_BIDI_DATA
DataFile = BP2000.GPD
Include = NTPRINT.INF
Needs = UNIDRV.OEM
AddReg=UninstInfo.AddReg64


[UninstInfo.AddReg]
HKLM,"%UNINSTKEY%","caption",0x00000000,"%UNINSTCAPTION%"
HKLM,"%UNINSTKEY%","DisplayName",0x00000000,"%UNINSTDISPLAY%"
HKLM,"%UNINSTKEY%","UninstallString",0x00000000,"%52%\3\LMPrnUni.exe"
HKLM,"%UNINSTKEY%\PrinterDrivers\%DRVNAME%","Leave OEM INF",0x00010001,0x00000001

[UninstInfo.AddReg64]
HKLM,"%UNINSTKEY64%","caption",0x00000000,"%UNINSTCAPTION%"
HKLM,"%UNINSTKEY64%","DisplayName",0x00000000,"%UNINSTDISPLAY%"
HKLM,"%UNINSTKEY64%","UninstallString",0x00000000,"%52%\3\LMPrnUni.exe"
HKLM,"%UNINSTKEY64%\PrinterDrivers\%DRVNAME%","Leave OEM INF",0x00010001,0x00000001

[OEM_BIDI_DATA]
DriverFile = UNIDRV.DLL
ConfigFile = UNIDRVUI.DLL
HelpFile = UNIDRV.HLP

[OEM_SETUP]
LMPrnUni.exe,,,0x20

[DestinationDirs]
DefaultDestDir = 66000

[SourceDisksNames]
81 = %disk1%,,,\i386
32 = %disk1%,,,\i386

[SourceDisksNames.X86]
1 = %disk1%,,,\i386

[SourceDisksNames.amd64]
1 = %disk1%,,,\X64

[SourceDisksNames.IA64]
1 = %disk1%,,,\IA64


;++++++++++++++++++++++++++++
[SourceDisksFiles]
BP2000.Dll = 1
BP2000.GPD = 81
LMPrnUni.exe = 81

[OEM URLs]
%ProviderName% = %LEDOMARSURL%

[Strings]
PrinterClassName = "Printers"
ProviderName = "LEDOMARS"
LEDOMARSURL = "http://www.LEDOMARS.com"
disk1 = "LEDOMARS Printer Driver Setup Disk"
DRVNAME = "LEDOMARS BP-2000"
UNINSTKEY = "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\LEDOMARS Printer Utilities"
UNINSTKEY64 = "SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\LEDOMARS Printer Utilities"
UNINSTCAPTION = "LEDOMARS Printer Drivers UnInstaller"
UNINSTDISPLAY = "Remove LEDOMARS Printer Drivers"
